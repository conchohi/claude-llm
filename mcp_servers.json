{
  "mcpServers": {
    "filesystem": {
      "command": "python",
      "args": ["-m", "mcp.server.filesystem", "./data"],
      "env": {},
      "description": "File system access for document retrieval",
      "enabled": false
    },
    "tavily_search": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@0.1.4"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "description": "Tavily search MCP server",
      "enabled": true
    },
    "custom-server": {
      "command": "python",
      "args": ["./custom_mcp_servers/my_server.py"],
      "env": {
        "CUSTOM_CONFIG": "value"
      },
      "description": "Your custom MCP server implementation (file-based)",
      "enabled": false
    },
    "java-datetime": {
      "command": "java",
      "args": ["-jar", "./mcp_servers/mcp-date.jar"],
      "env": {
        "JAVA_OPTS": "-Xmx512m"
      },
      "description": "현재 시간을 알려주는 MCP 서버 (Java 기반)",
      "enabled": true
    },
    "custom-http-server": {
      "type": "http",
      "url": "http://localhost:3001/mcp",
      "headers": {
        "Authorization": "Bearer ${CUSTOM_SERVER_TOKEN}"
      },
      "description": "Custom MCP server via HTTP (already running)",
      "enabled": false
    }
  }
}
